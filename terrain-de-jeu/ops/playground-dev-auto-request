#!/usr/bin/env bash
set -Eeuo pipefail

readonly SOURCE_CONFIG='/etc/playground-dev-source.env'
readonly REQUEST='/run/playground-dev/deploy.request'
readonly STATE_DIR='/var/lib/playground-dev'
readonly DEPLOYED_STATE="$STATE_DIR/deployed_commit"
readonly REQUESTED_STATE="$STATE_DIR/auto_requested_commit"
readonly REQUEST_CMD='/usr/local/bin/playground-dev-request'

log() { printf '[playground-auto] %s\n' "$*"; }
fail() { printf '[playground-auto] ERROR: %s\n' "$*" >&2; exit 1; }

[ -r "$SOURCE_CONFIG" ] || fail "missing source configuration: $SOURCE_CONFIG"
# shellcheck disable=SC1090
source "$SOURCE_CONFIG"

REPO_URL="${PLAYGROUND_REPO_URL:-https://github.com/giusmili/cours-python.git}"
BRANCH="${PLAYGROUND_BRANCH:-kevin/missions}"
GIT_SSH_KEY="${PLAYGROUND_GIT_SSH_KEY:-}"
GIT_KNOWN_HOSTS="${PLAYGROUND_GIT_KNOWN_HOSTS:-/etc/playground-dev-github-known_hosts}"
GITHUB_TOKEN_FILE="${PLAYGROUND_GITHUB_TOKEN_FILE:-}"

case "$REPO_URL" in
  'https://github.com/giusmili/cours-python.git'|'git@github.com:giusmili/cours-python.git') ;;
  *) fail "unexpected repository URL: $REPO_URL" ;;
esac
[ "$BRANCH" = 'kevin/missions' ] || fail "unexpected branch: $BRANCH"

if [[ "$REPO_URL" == git@github.com:* ]]; then
  [ -n "$GIT_SSH_KEY" ] || fail 'private SSH source requires PLAYGROUND_GIT_SSH_KEY'
  [ -r "$GIT_SSH_KEY" ] || fail "unreadable deploy key: $GIT_SSH_KEY"
  [ -r "$GIT_KNOWN_HOSTS" ] || fail "unreadable known_hosts: $GIT_KNOWN_HOSTS"
  export GIT_SSH_COMMAND="ssh -i $GIT_SSH_KEY -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$GIT_KNOWN_HOSTS"
fi

head_sha="$(git ls-remote "$REPO_URL" "refs/heads/$BRANCH" | awk 'NR == 1 {print $1}')"
[[ "$head_sha" =~ ^[0-9a-f]{40}$ ]] || fail 'cannot resolve kevin/missions'

deployed="$(cat "$DEPLOYED_STATE" 2>/dev/null || true)"
[ "$deployed" != "$head_sha" ] || exit 0

requested="$(cat "$REQUESTED_STATE" 2>/dev/null || true)"
[ "$requested" != "$head_sha" ] || exit 0

if [ -e "$REQUEST" ]; then
  log 'a deployment request is already queued'
  exit 0
fi

set +e
TARGET_SHA="$head_sha" GITHUB_TOKEN_FILE="$GITHUB_TOKEN_FILE" python3 - <<'PY'
import json
import os
import pathlib
import sys
import urllib.error
import urllib.request

sha = os.environ["TARGET_SHA"]
token_file = os.environ.get("GITHUB_TOKEN_FILE", "").strip()
headers = {
    "Accept": "application/vnd.github+json",
    "User-Agent": "playground-dev-auto-request",
}
if token_file:
    path = pathlib.Path(token_file)
    if not path.is_file():
        print(f"configured GitHub token file is missing: {path}", file=sys.stderr)
        raise SystemExit(2)
    token = path.read_text(encoding="utf-8").strip()
    if not token:
        print(f"configured GitHub token file is empty: {path}", file=sys.stderr)
        raise SystemExit(2)
    headers["Authorization"] = f"Bearer {token}"

url = (
    "https://api.github.com/repos/giusmili/cours-python/actions/runs"
    f"?head_sha={sha}&status=completed&per_page=20"
)
request = urllib.request.Request(url, headers=headers)
try:
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.load(response)
except urllib.error.HTTPError as exc:
    print(
        f"cannot verify GitHub Actions status: HTTP {exc.code}; "
        "configure a read-only Actions token when the repository is private",
        file=sys.stderr,
    )
    raise SystemExit(2)
except Exception as exc:
    print(f"cannot verify GitHub Actions status: {exc}", file=sys.stderr)
    raise SystemExit(2)

ok = any(
    run.get("name") == "Terrain de jeu CI"
    and run.get("conclusion") == "success"
    and run.get("event") == "push"
    and run.get("head_sha") == sha
    and run.get("head_branch") == "kevin/missions"
    for run in payload.get("workflow_runs", [])
)
raise SystemExit(0 if ok else 3)
PY
ci_status=$?
set -e

if [ "$ci_status" -eq 3 ]; then
  log "HEAD $head_sha is not CI-green yet"
  exit 0
fi
[ "$ci_status" -eq 0 ] || exit "$ci_status"

"$REQUEST_CMD" "$head_sha"
printf '%s\n' "$head_sha" > "$REQUESTED_STATE"
chmod 0644 "$REQUESTED_STATE"
log "queued CI-green HEAD $head_sha"
