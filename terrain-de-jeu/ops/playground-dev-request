#!/usr/bin/env bash
set -Eeuo pipefail

readonly REQUEST_DIR='/run/playground-dev'
readonly REQUEST="$REQUEST_DIR/deploy.request"
readonly SOURCE_CONFIG='/etc/playground-dev-source.env'

fail() { printf '[playground-request] ERROR: %s\n' "$*" >&2; exit 1; }

configure_source() {
  [ -r "$SOURCE_CONFIG" ] || fail "missing source configuration: $SOURCE_CONFIG"
  # shellcheck disable=SC1090
  source "$SOURCE_CONFIG"

  REPO_URL="${PLAYGROUND_REPO_URL:-https://github.com/giusmili/cours-python.git}"
  BRANCH="${PLAYGROUND_BRANCH:-kevin/missions}"
  GIT_SSH_KEY="${PLAYGROUND_GIT_SSH_KEY:-}"
  GIT_KNOWN_HOSTS="${PLAYGROUND_GIT_KNOWN_HOSTS:-/etc/playground-dev-github-known_hosts}"

  case "$REPO_URL" in
    'https://github.com/giusmili/cours-python.git'|'git@github.com:giusmili/cours-python.git') ;;
    *) fail "unexpected repository URL: $REPO_URL" ;;
  esac
  [ "$BRANCH" = 'kevin/missions' ] || fail "unexpected branch: $BRANCH"

  if [[ "$REPO_URL" == git@github.com:* ]]; then
    [ -n "$GIT_SSH_KEY" ] || fail 'private SSH source requires PLAYGROUND_GIT_SSH_KEY'
    [ -r "$GIT_SSH_KEY" ] || fail "unreadable deploy key: $GIT_SSH_KEY"
    [ -r "$GIT_KNOWN_HOSTS" ] || fail "unreadable known_hosts: $GIT_KNOWN_HOSTS"
    export GIT_SSH_COMMAND="ssh -i $GIT_SSH_KEY -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$GIT_KNOWN_HOSTS"
  fi
}

sha="${1:-}"
if [ -z "$sha" ]; then
  configure_source
  sha="$(git ls-remote "$REPO_URL" "refs/heads/$BRANCH" | awk 'NR == 1 {print $1}')"
fi

[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || {
  echo 'Invalid or unavailable kevin/missions SHA.' >&2
  exit 2
}

[ -d "$REQUEST_DIR" ] || {
  echo 'Preview deploy broker is not installed.' >&2
  exit 3
}

if [ -e "$REQUEST" ]; then
  echo 'A preview deploy request is already queued.' >&2
  exit 4
fi

umask 027
tmp="$REQUEST_DIR/.deploy.request.$$"
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$sha" > "$tmp"
mv "$tmp" "$REQUEST"
trap - EXIT

printf 'Queued playground-dev deployment: %s\n' "$sha"
